# PostgreSQL connection string.
# asyncpg (runtime) uses the postgresql:// scheme directly.
# Alembic env.py converts this to postgresql+psycopg2:// for migration runs.
# Supabase direct connection (not pooler) is recommended for the app server.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Supabase project settings
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret — used server-side to verify tokens without hitting Supabase Auth API
SUPABASE_JWT_SECRET=

# Cloudflare CDN base URL — backend prepends this to all Storage paths in responses
CDN_BASE_URL=https://cdn.kingguru.app

# Google Gemini — used for Daily Essay grading and AI Tutor (Phase 2+)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model id for generateContent (see ListModels API for your key)
GEMINI_MODEL=gemini-2.5-flash

# Azure Neural TTS (Phase 1 vocabulary audio — English + Sinhala)
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus

# Sentry DSN — leave empty in development to suppress Sentry init
SENTRY_DSN=

# App environment: development | staging | production
APP_ENV=development

# Comma-separated list of allowed CORS origins (web frontend only — see note
# below). Defaults to "*" if unset.
CORS_ORIGINS=https://kingguru.ai,https://www.kingguru.ai,http://localhost:5173
